# Copy this file to credentials.env and fill it in. credentials.env is
# gitignored and never leaves your machine except as the config file that
# deploy.sh installs on the Wazuh manager.
#
# Create the credential in Sophos Central:
#   Global Settings -> API Credentials Management -> Add Credential
#   Role: Service Principal ReadOnly
# The client secret is shown only once.

SOPHOS_CLIENT_ID=00000000-0000-0000-0000-000000000000
SOPHOS_CLIENT_SECRET=replace-me

# --- Optional ---------------------------------------------------------------

# Poll mobile/v1/devices/{id}/installed-apps on every run. One extra API call
# per device per cycle. Set to false on large fleets.
SOPHOS_POLL_INSTALLED_APPS=true

# JSON array of Python regexes matched against each installed app's identifier
# and name. Every hit raises rule 100628 (level 12), once per device per app.
# Example: ["(?i)tiktok", "(?i)telegram", "^com\\.evil\\."]
SOPHOS_FORBIDDEN_APPS=[]
